{
  "name": "clm-catalog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "prisma generate && next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migration": "node scripts/new-migration.mjs",
    "db:migrate": "wrangler d1 migrations apply clm --remote",
    "db:migrate:local": "wrangler d1 migrations apply clm --local --env local",
    "migrate:supabase": "node scripts/migrate-from-supabase.mjs",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "16.4.6",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "worker-mailer": "1.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "enhanced-resolve": "^5.26.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "4.162.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@11.11.0",
  "overrides": {
    "enhanced-resolve": "^5.26.0"
  }
}
