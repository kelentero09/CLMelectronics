# CLM Catalog — local development settings. Copy to .env (never commit .env).
# Setup guide: CLOUDFLARE_SETUP.md
#
# Cloudflare bindings (D1 database, Images) are NOT configured here:
# they come from wrangler.jsonc. Production secrets are set with
#   pnpm wrangler secret put <NAME>

# --- Auth (Better Auth) ---
# Random 32+ character string. Production: `pnpm wrangler secret put BETTER_AUTH_SECRET`
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# --- Site URL ---
# Used for invite / password-reset links and as the auth base URL. Never derived
# from request headers. Production value lives in wrangler.jsonc `vars`.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (SMTP) ---
# Without SMTP, invites show a copyable link and dev reset links are logged to the console.
# Production: set these with `pnpm wrangler secret put SMTP_PASS` (and the others).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"              # 465 = TLS (recommended on Workers), 587 = STARTTLS
# SMTP_USER="you@gmail.com"
# SMTP_PASS="app-password"     # Gmail: an App Password, not your normal password
# SMTP_FROM="CLM Electronics <you@gmail.com>"
# SMTP_SECURE="true"           # true for 465

# --- Rate limiting (optional, recommended in production) ---
# Without these, limits are kept in memory per Worker instance (best effort).
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxx"

# --- Seeding (optional) ---
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"

# --- One-time Supabase → Cloudflare migration (pnpm migrate:supabase) ---
# Remove these once the migration is done and verified.
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# SUPABASE_SECRET_KEY="[SECRET_KEY]"   # only if the product-images bucket is private
