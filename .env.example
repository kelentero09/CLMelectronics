# CLM Catalog — copy to .env and fill in (see SUPABASE_SETUP.md). Never commit .env.

# --- Supabase API (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[PUBLISHABLE_KEY]"

# --- Server-only (Project Settings > API; never expose to the browser) ---
SUPABASE_SECRET_KEY="[SECRET_KEY]"

# --- Prisma + Supabase PostgreSQL (Project Settings > Database) ---
# Pooled (transaction mode, port 6543) for the app:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Site URL (required for email links) ---
# Production: "https://clm.yourdomain.com"  Dev: "http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Storage ---
# NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="product-images"

# --- Email (Node mailer — bypasses Supabase rate limits, free) ---
# Option A: No SMTP set = no email sent, invite link shown in UI to copy (100% free, zero config)
# Option B: Set these to auto-send via Node (free, uses your own SMTP, no Supabase quota):
# Example free: Gmail app password, or Resend free tier (3k/month)
# SMTP_HOST="smtp.gmail.com"   # or smtp.resend.com, smtp.sendgrid.net, etc.
# SMTP_PORT="587"              # 465 for SSL, 587 for TLS
# SMTP_USER="you@gmail.com"    # or resend apikey
# SMTP_PASS="app-password"     # Gmail app password or resend api key
# SMTP_FROM="CLM Electronics <noreply@yourdomain.com>"
# SMTP_SECURE="false"          # true for 465

# --- Email branding (Supabase dashboard, legacy if you still use Supabase mailer) ---
# See SUPABASE_SETUP.md §7 and supabase/email-templates/*.html
# SUPABASE_ACCESS_TOKEN="sbp_xxx"  # for scripts/apply-email-templates.mjs
# SUPABASE_PROJECT_REF="[PROJECT_REF]"
