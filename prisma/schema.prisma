// CLM Catalog — Production Schema
// SQLite on Cloudflare D1 (accessed through @prisma/adapter-d1, see lib/db.ts).
// Schema changes: `pnpm db:migration <name>` writes a SQL migration to /migrations.
// NOTE: there is intentionally NO price / currency / monetary column
// anywhere in this schema. This catalog is for information and inquiry only.

generator client {
  provider        = "prisma-client-js"
  // Rust-free client: a small TypeScript/WASM query compiler instead of the
  // 2 MB query engine (needed to fit the Cloudflare Workers free plan).
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  // Only used by Prisma CLI tooling (migrate diff). At runtime the D1 adapter is used.
  url      = "file:./dev.db"
}

enum UserRole {
  ADMIN
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
  SURPLUS
  FOR_PARTS
}

enum ProductAvailability {
  IN_STOCK
  LOW_STOCK
  RESERVED
  SOLD
  UNAVAILABLE
}

enum InquiryStatus {
  NEW
  CONTACTED
  COMPLETED
}

// Admin users. Better Auth (lib/auth.ts) owns credentials (accounts.password)
// and sessions; this table also stores the app role and the invite state.
// inviteToken holds sha256(token) for the /auth/accept-invite flow.
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  emailVerified         Boolean   @default(false)
  image                 String?
  role                  UserRole  @default(ADMIN)
  isActive              Boolean   @default(true)
  invitedAt             DateTime?
  inviteAccepted        Boolean   @default(false)
  inviteToken           String?   @unique
  inviteTokenExpiresAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  sessions              Session[]
  accounts              Account[]

  @@map("users")
}

// ---- Better Auth tables (https://www.better-auth.com/docs/concepts/database) ----

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Password hash: "pbkdf2-sha256$..." (lib/password.ts) or a legacy bcrypt
  // hash imported from Supabase Auth (upgraded on the next sign-in).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  referenceCode    String              @unique
  categoryId       String?
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  model            String?
  partNumber       String?
  manufacturer     String?
  shortDescription String?
  description      String?
  specifications   Json?
  datasheetUrl     String?
  condition        ProductCondition?
  availability     ProductAvailability @default(IN_STOCK)
  published        Boolean             @default(false)
  featured         Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  images           ProductImage[]
  inquiries        Inquiry[]

  @@index([categoryId, published, deletedAt])
  @@index([published, deletedAt, createdAt(sort: Desc)])
  @@index([published, deletedAt, manufacturer])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Inquiry {
  id         String        @id @default(cuid())
  productId  String?
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productRef String?
  name       String
  email      String
  phone      String?
  company    String?
  message    String
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
  @@map("inquiries")
}

// Website CMS contents (managed in /admin/content, shown on storefront).
// `key` is the stable lookup key (e.g. "company.name"); `value` holds plain
// text and `data` holds structured JSON for lists (cards, points, groups).
// Seeded from the current website copy — DB is source of truth, static
// defaults in data/site-content-defaults.ts are fallback for speed/safety.
model SiteContent {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String   @default("general")
  label       String
  description String?
  value       String   @default("")
  data        Json?
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([group, sortOrder])
  @@map("site_contents")
}

// Board repair capability records (managed in /admin/repairs, shown on
// /board-repair). `key` is the stable seed key (e.g. "da-01"); new admin
// entries get a generated key. Images are WebP — either local /public paths
// or /media/... URLs served from the R2 bucket (see app/media).
model BoardRepair {
  id               String   @id @default(cuid())
  key              String   @unique
  station          String
  model            String
  boardDescription String
  image            String?
  problem          String
  repairRate       Int      @default(95)
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([station])
  @@index([isActive])
  @@map("board_repairs")
}

// Uploaded images (product photos, board-repair photos), stored in D1 itself
// and served by app/media/[...path]/route.ts at /media/<key>. Uploads are
// resized to ~600px WebP first, so files are small (D1 max row size: 2 MB).
model MediaFile {
  key         String   @id
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@map("media_files")
}
