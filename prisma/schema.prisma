// CLM Catalog — Production Schema
// PostgreSQL via Supabase (dedicated CLM Supabase project — NEVER shared
// with any other business/project).
// NOTE: there is intentionally NO price / currency / monetary column
// anywhere in this schema. This catalog is for information and inquiry only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
  SURPLUS
  FOR_PARTS
}

enum ProductAvailability {
  IN_STOCK
  LOW_STOCK
  RESERVED
  SOLD
  UNAVAILABLE
}

enum InquiryStatus {
  NEW
  CONTACTED
  COMPLETED
}

// Application-level authorization (Supabase Auth owns credentials;
// this table stores only the role, linked by email).
// inviteToken is for pure-Postgres invite flow (no Supabase email) — used by /auth/accept-invite
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  role                  UserRole  @default(ADMIN)
  isActive              Boolean   @default(true)
  invitedAt             DateTime?
  inviteAccepted        Boolean   @default(false)
  inviteToken           String?   @unique
  inviteTokenExpiresAt  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id               String              @id @default(cuid())
  name             String
  slug             String              @unique
  referenceCode    String              @unique
  categoryId       String?
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  model            String?
  partNumber       String?
  manufacturer     String?
  shortDescription String?             @db.VarChar(300)
  description      String?             @db.Text
  specifications   Json?
  datasheetUrl     String?
  condition        ProductCondition?
  availability     ProductAvailability @default(IN_STOCK)
  published        Boolean             @default(false)
  featured         Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  images           ProductImage[]
  inquiries        Inquiry[]

  @@index([categoryId, published, deletedAt])
  @@index([published, deletedAt, createdAt(sort: Desc)])
  @@index([published, deletedAt, manufacturer])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Inquiry {
  id         String        @id @default(cuid())
  productId  String?
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productRef String?       @db.VarChar(50)
  name       String        @db.VarChar(50)
  email      String        @db.VarChar(255)
  phone      String?       @db.VarChar(20)
  company    String?       @db.VarChar(50)
  message    String        @db.VarChar(500)
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
  @@map("inquiries")
}

// Website CMS contents (managed in /admin/content, shown on storefront).
// `key` is the stable lookup key (e.g. "company.name"); `value` holds plain
// text and `data` holds structured JSON for lists (cards, points, groups).
// Seeded from the current website copy — DB is source of truth, static
// defaults in data/site-content-defaults.ts are fallback for speed/safety.
model SiteContent {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String   @default("general")
  label       String
  description String?
  value       String   @default("") @db.Text
  data        Json?
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([group, sortOrder])
  @@map("site_contents")
}

// Board repair capability records (managed in /admin/repairs, shown on
// /board-repair). `key` is the stable seed key (e.g. "da-01"); new admin
// entries get a generated key. Images are WebP — either local /public paths
// or Supabase Storage public URLs (uploads convert to WebP server-side).
model BoardRepair {
  id               String   @id @default(cuid())
  key              String   @unique
  station          String
  model            String
  boardDescription String
  image            String?
  problem          String
  repairRate       Int      @default(95)
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([station])
  @@index([isActive])
  @@map("board_repairs")
}
